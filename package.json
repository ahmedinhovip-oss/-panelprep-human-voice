{
  "name": "panelprep",
  "version": "1.0.0",
  "private": true,
  "description": "Practise a job interview out loud with an AI panel (HR Manager, General Manager, Specialist), then get a scored PDF report and a study mind map.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "smoke": "node scripts/smoke-test.js",
    "build:artifact": "node artifact/build.mjs",
    "voices": "node scripts/test-voices.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "compression": "^1.8.2",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "unpdf": "^1.8.1"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
