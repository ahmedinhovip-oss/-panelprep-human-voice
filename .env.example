# Required for real interviews. Without it the app runs in demo mode
# (scripted panel, rough scores) so you can try the whole flow first.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Interviewer voices and voice answers (ElevenLabs is the primary engine).
# With this key the panel speaks with ElevenLabs voices (Eleven v4 Turbo) and the
# candidate's recorded answers are turned into text with ElevenLabs Scribe.
# Get a key at https://elevenlabs.io (Profile > API keys). Keep it here only:
# it is never sent to the browser.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=

# One fixed voice per interviewer. In ElevenLabs open Voices (or the Voice Library),
# pick a voice, copy its Voice ID and paste it here. Defaults if left empty:
# HR Matilda (warm woman), GM Brian (mature man), Specialist Alice (confident woman).
ELEVENLABS_HR_VOICE_ID=
ELEVENLABS_GM_VOICE_ID=
ELEVENLABS_SPECIALIST_VOICE_ID=
# Gender of each chosen voice, so the interviewer's name fits it (female or male).
# ELEVENLABS_HR_GENDER=female
# ELEVENLABS_GM_GENDER=male
# ELEVENLABS_SPECIALIST_GENDER=female
# ELEVENLABS_MODEL=eleven_v4
# eleven_v4 gives the most natural quality in this build.
# eleven_v4_turbo requires a realtime Text-to-Dialogue WebSocket integration.
# ELEVENLABS_STT_MODEL=scribe_v2

# Optional alternative: OpenAI voices and transcription.
# Set TTS_PROVIDER=openai and/or STT_PROVIDER=openai to use it instead.
OPENAI_API_KEY=

# Optional. Share this code with your testers so strangers can't use your credit.
APP_ACCESS_CODE=

PORT=3000
APP_NAME=PanelPrep

# Set to 1 when running behind a proxy or load balancer (Render, Railway, Fly, Nginx).
# TRUST_PROXY=1

# Force demo mode even with a key.
# DEMO_MODE=1

# Models (defaults shown). The live panel uses the fastest model so replies come quickly.
# MODEL_PLAN=claude-sonnet-5-5
# MODEL_TURN=claude-haiku-4-5
# MODEL_EVALUATE=claude-sonnet-5-5
# MODEL_EXTRACT=claude-haiku-4-5

# OpenAI speech models (only used when the provider is openai)
# STT_MODEL=gpt-4o-mini-transcribe
# TTS_MODEL=gpt-4o-mini-tts
# OPENAI_BASE_URL=https://api.openai.com/v1
# DISABLE_SERVER_STT=1
# DISABLE_SERVER_TTS=1
